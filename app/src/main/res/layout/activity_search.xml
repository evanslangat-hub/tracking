<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".SearchActivity">

        <!-- TOP SECTION -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- BACK -->
            <TextView
                android:id="@+id/btnBack"
                android:text="‹ Back"
                android:textColor="#2563EB"
                android:textSize="12sp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <!-- SEARCH BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="#F3F4F6"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="#888"/>

                <TextView
                    android:id="@+id/selectedPlace"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Nairobi Hospital"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:textColor="#111"/>

                <TextView
                    android:text="✕"
                    android:textSize="12sp"
                    android:background="#CCC"
                    android:padding="4dp"
                    android:textColor="#FFF"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
            </LinearLayout>

            <!-- FILTER CHIPS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView style="@style/chipActive" android:text="All"/>
                    <TextView style="@style/chipInactive" android:text="Hospitals"/>
                    <TextView style="@style/chipInactive" android:text="Malls"/>
                    <TextView style="@style/chipInactive" android:text="Offices"/>
                    <TextView style="@style/chipInactive" android:text="Stations"/>

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>

        <!-- MAP STRIP -->
        <FrameLayout
            android:id="@+id/mapPreview"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:background="#E8F0FE"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- You can replace this later with Google Map fragment -->

            <TextView
                android:text="Map Preview"
                android:layout_gravity="center"
                android:textColor="#888"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

        </FrameLayout>

        <!-- RESULTS LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchRecycler"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/mapPreview"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- BOTTOM BUTTON -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/btnSelect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="Select Destination"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:background="#2563EB"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>